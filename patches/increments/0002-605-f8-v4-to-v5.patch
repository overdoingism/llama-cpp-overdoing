 #pragma unroll
-            for (int v = 0; v < 8; ++v) { p[v] = __builtin_amdgcn_exp2f(fmaf(s[ks_][v], cc, -msub)); ls += p[v]; }
+            for (int v = 0; v < 8; ++v) p[v] = __builtin_amdgcn_exp2f(fmaf(s[ks_][v], cc, -msub));
             const uint2 w = lf_pack_fp8(p, 1.f);
+            ls += lf_sum_fp8(w);
             p8[ks_] = lf_v2i{(int) w.x, (int) w.y};
         }
         l = l * alpha + ls;
