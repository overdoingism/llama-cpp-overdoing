 // ggml_compute_forward_gated_delta_net
+
+// replay the first n tokens of a batch's factors (ggml_gated_delta_net_anchor) onto head iv1's state: the token update
+// of the loop below, without the attention output
+static void ggml_gated_delta_net_replay_head(float * s, const float * fac, int64_t n_fac, int64_t n, int64_t S_v,
+        int64_t H, int64_t H_k, int64_t iv1, float * delta) {
+    for (int64_t t = 0; t < n; ++t) {
+        const float * row      = fac + t * n_fac;
+        const float * v_d      = row + iv1 * S_v;
+        const float * k_d      = row + S_v * H + (iv1 % H_k) * S_v;
+        const float   g_val    = row[S_v * H + S_v * H_k + iv1];
+        const float   beta_val = row[S_v * H + S_v * H_k + H + iv1];
+
+        ggml_vec_scale_f32(S_v * S_v, s, g_val);
+        for (int64_t j = 0; j < S_v; ++j) {
+            float sum = 0.0f;
+            ggml_vec_dot_f32(S_v, &sum, 0, &s[j * S_v], 0, k_d, 0, 1);
+            delta[j] = (v_d[j] - sum) * beta_val;
+        }
+        for (int64_t j = 0; j < S_v; ++j) {
+            ggml_vec_mad_f32(S_v, &s[j * S_v], k_d, delta[j]);
+        }
+    }
+}
