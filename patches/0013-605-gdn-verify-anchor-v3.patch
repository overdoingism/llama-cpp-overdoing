+// GGML_OP_GATED_DELTA_NET, anchored (ggml_gated_delta_net_anchor): replay of the previous batch's factors, then the batch
+struct test_gated_delta_net_anchor : public test_case {
+    const int64_t head_count;   // k heads
+    const int64_t head_size;
+    const int64_t n_seq_tokens;
+    const int64_t n_seqs;
+    const int     v_repeat;
+    const int64_t n_fac_tokens; // rows of the previous batch's factors (0: no replay input)
+    const bool    beta_sig;     // beta through a sigmoid node (the CUDA backend fuses it into the kernel)
+    const bool    rows;         // ggml_gated_delta_net_anchor_rows: the factors by row id
