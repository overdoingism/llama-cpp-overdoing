+#pragma once
+#include "common.cuh"
+// mmvk: dense Q4_K / Q5_K / Q6_K matmul for 1..8 columns (decode and speculative verify).  A lane owns one 32-value
+// sub-block, loads the q8_1 activations of all columns for it once and runs several weight rows against them, so at the
+// verify widths the activations stay in registers across the rows.  The per-output arithmetic (sub-block order per lane,
+// 32-lane butterfly) does not depend on the column count, so decode and verify stay bit-identical to each other; integer
+// dot products and scales are MMVQ's, only the float summation order differs from MMVQ.
+// GGML_CUDA_MMVK=1: single launches; =2: also groups the MUL_MATs that read the same src1 into one launch ("tetris"),
+// weight types mixed within a group (GGML_CUDA_MMVK_EXT bit 1, default on; bit 2 adds IQ4_XS / IQ4_NL / MXFP4, opt-in).
+// 1 and 2 run only when the program verifies speculative drafts (one-token decode alone is faster on the stock kernel);
+// 3 and 4 are the same, always.  Off (unset): nothing changes.
+bool ggml_cuda_mmvk_takes(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst);
+// weight-type check only (for the fusions that must stand down so decode and verify use the same kernel)
+bool ggml_cuda_mmvk_type(ggml_type type);
+void ggml_cuda_mmvk_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+bool ggml_cuda_mmvk_group_on();
+void ggml_cuda_mmvk_group_reorder(struct ggml_cgraph * cgraph);
+int  ggml_cuda_mmvk_group(ggml_backend_cuda_context & ctx, struct ggml_cgraph * cgraph, int i);
+// "ggml_backend_set_speculative_decoding": whether drafts will be verified; returns a status line for the log (nullptr if
+// GGML_CUDA_MMVK is unset)
+const char * ggml_cuda_mmvk_set_speculative(bool on);
