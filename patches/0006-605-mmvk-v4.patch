 #include <algorithm>
 #include <numeric>
@@ -1963,6 +1964,14 @@ int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgrap
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    // mmvk group ("tetris", GGML_CUDA_MMVK=2): dense K-quant MUL_MATs on the same src1 as one launch.
+    if (node->op == GGML_OP_MUL_MAT && ggml_cuda_mmvk_group_on()) {
+        const int taken = ggml_cuda_mmvk_group(*cuda_ctx, cgraph, i);
