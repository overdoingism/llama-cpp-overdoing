From 5289d5671139f3d4ec71591e5befe97368e123a7 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:27:02 +0800
Subject: [PATCH] anchored GDN: on by default (LLAMA_RS_ANCHOR=0 turns it off;
 unset, GGML_LF_ALL=0 too)

Unset, a recurrent layer on a backend without the anchored ops now logs at info level instead of warning: those backends
just keep the snapshot planes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-memory-recurrent.cpp | 13 +++++++++----
 src/llama-memory-recurrent.h   |  2 +-
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/src/llama-memory-recurrent.cpp b/src/llama-memory-recurrent.cpp
index 71e32a9ab..9f4ebf5c2 100644
--- a/src/llama-memory-recurrent.cpp
+++ b/src/llama-memory-recurrent.cpp
@@ -38,10 +38,13 @@ llama_memory_recurrent::llama_memory_recurrent(
     this->n_rs_seq   = n_rs_seq;
     this->n_rs_batch = n_rs_batch > 0 ? n_rs_batch : n_rs_seq + 1;
 
-    // anchored rollback (see the header): the scalar-gate delta-net models only
+    // anchored rollback (see the header): the scalar-gate delta-net models only; on unless LLAMA_RS_ANCHOR=0 (unset with
+    // GGML_LF_ALL=0: off)
     {
-        const char * e = getenv("LLAMA_RS_ANCHOR");
-        anchor = e != nullptr && atoi(e) != 0 && n_rs_seq > 0 && type_s == GGML_TYPE_F32 &&
+        const char * anchor_env = getenv("LLAMA_RS_ANCHOR");
+        const char * a          = getenv("GGML_LF_ALL");
+        const bool want = anchor_env != nullptr ? atoi(anchor_env) != 0 : !(a != nullptr && a[0] == '0' && a[1] == '\0');
+        anchor = want && n_rs_seq > 0 && type_s == GGML_TYPE_F32 &&
                  (model.arch == LLM_ARCH_QWEN35 || model.arch == LLM_ARCH_QWEN35MOE);
         if (anchor) {
             const int64_t S   = hparams.ssm_d_state;
@@ -62,7 +65,9 @@ llama_memory_recurrent::llama_memory_recurrent(
             const char * reg = ggml_backend_reg_name(ggml_backend_dev_backend_reg(dev));
             if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU &&
                 strcmp(reg, "CUDA") != 0 && strcmp(reg, "ROCm") != 0 && strcmp(reg, "MUSA") != 0) {
-                LLAMA_LOG_WARN("%s: LLAMA_RS_ANCHOR: layer %d is on %s (%s), which has no anchored delta-net ops; anchored rollback disabled\n",
+                // a warning only when asked for (unset, these backends keep the snapshot planes as before)
+                llama_log_internal(anchor_env != nullptr ? GGML_LOG_LEVEL_WARN : GGML_LOG_LEVEL_INFO,
+                        "%s: LLAMA_RS_ANCHOR: layer %d is on %s (%s), which has no anchored delta-net ops; anchored rollback disabled\n",
                         __func__, i, ggml_backend_dev_name(dev), reg);
                 anchor = false;
             }
diff --git a/src/llama-memory-recurrent.h b/src/llama-memory-recurrent.h
index ee9fc002f..b43b0c940 100644
--- a/src/llama-memory-recurrent.h
+++ b/src/llama-memory-recurrent.h
@@ -81,7 +81,7 @@ public:
     // per-seq rollback index
     std::vector<uint32_t> rs_idx;
 
-    // anchored rollback (LLAMA_RS_ANCHOR=1, delta-net models): the ssm state has two planes instead of 1 + n_rs_seq --
+    // anchored rollback (LLAMA_RS_ANCHOR, on unless 0; delta-net models): the ssm state has two planes instead of 1 + n_rs_seq --
     // plane 0 the state after the cell's last batch, plane 1 the state that batch started from -- and each cell keeps
     // the replay factors of its last batch (ggml_gated_delta_net_anchor) in one of two factor rows, by parity.  A
     // rollback by r tokens is then the start state with the first n_fac - r tokens replayed; the conv state keeps its
-- 
2.43.0

