+int64_t ggml_gated_delta_net_n_fac(int64_t S_v, int64_t H_v, int64_t S_k, int64_t H_k) {
+    return S_v * H_v + S_k * H_k + 2 * H_v;
+}
+
+struct ggml_tensor * ggml_gated_delta_net_anchor(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * g,
+        struct ggml_tensor  * beta,
+        struct ggml_tensor  * state,
+        struct ggml_tensor  * fac_prev,
+        struct ggml_tensor  * n_replay) {
+    GGML_ASSERT(ggml_is_contiguous_rows(q));
+    GGML_ASSERT(ggml_is_contiguous_rows(k));
+    GGML_ASSERT(ggml_is_contiguous_rows(v));
+    GGML_ASSERT(ggml_is_contiguous(g));
+    GGML_ASSERT(ggml_is_contiguous(beta));
+    GGML_ASSERT(ggml_is_contiguous(state));
+    GGML_ASSERT(q->type == GGML_TYPE_F32 && k->type == GGML_TYPE_F32 && v->type == GGML_TYPE_F32);
+    GGML_ASSERT(g->type == GGML_TYPE_F32 && beta->type == GGML_TYPE_F32 && state->type == GGML_TYPE_F32);
+
+    const int64_t S_v      = v->ne[0];
+    const int64_t H        = v->ne[1];
+    const int64_t n_tokens = v->ne[2];
+    const int64_t n_seqs   = v->ne[3];
+    const int64_t n_fac    = ggml_gated_delta_net_n_fac(S_v, H, k->ne[0], k->ne[1]);
+
+    GGML_ASSERT(g->ne[0] == 1 && beta->ne[0] == 1); // scalar gate only
+    GGML_ASSERT(k->ne[0] == S_v);
+    GGML_ASSERT(state->ne[0] == S_v && state->ne[1] == S_v && state->ne[2] == H && state->ne[3] == n_seqs);
+    GGML_ASSERT((fac_prev == NULL) == (n_replay == NULL));
+    if (fac_prev != NULL) {
+        GGML_ASSERT(fac_prev->type == GGML_TYPE_F32 && ggml_is_contiguous(fac_prev));
+        GGML_ASSERT(fac_prev->ne[0] == n_fac && fac_prev->ne[2] == n_seqs);
+        GGML_ASSERT(n_replay->type == GGML_TYPE_I32 && ggml_nelements(n_replay) == n_seqs);
+    }
+
+    // [attention scores | start state | final state | factors], flat
+    const int64_t ne0 = S_v * H * n_tokens * n_seqs + 2 * S_v * S_v * H * n_seqs + n_fac * n_tokens * n_seqs;
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne0);
+
+    ggml_set_op_params_i32(result, 0, 1); // K: the final state only
+    ggml_set_op_params_i32(result, 1, 0);
+    ggml_set_op_params_i32(result, 2, 1); // anchored
+
+    result->op     = GGML_OP_GATED_DELTA_NET;
+    result->src[0] = q;
+    result->src[1] = k;
+    result->src[2] = v;
+    result->src[3] = g;
+    result->src[4] = beta;
+    result->src[5] = state;
+    result->src[6] = fac_prev;
+    result->src[7] = n_replay;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_gated_delta_net_anchor_rows(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * g,
+        struct ggml_tensor  * beta,
+        struct ggml_tensor  * state,
+        struct ggml_tensor  * fac_all,
+        struct ggml_tensor  * fac_ids,
+        struct ggml_tensor  * n_replay) {
+    const int64_t n_fac = ggml_gated_delta_net_n_fac(v->ne[0], v->ne[1], k->ne[0], k->ne[1]);
+    GGML_ASSERT(fac_all->type == GGML_TYPE_F32 && fac_all->ne[0] % n_fac == 0 && fac_all->nb[0] == sizeof(float));
+    GGML_ASSERT(fac_ids->type == GGML_TYPE_I32 && ggml_nelements(fac_ids) == v->ne[3]);
+
+    // the anchored op without a factor input, then the rows and their ids
+    struct ggml_tensor * result = ggml_gated_delta_net_anchor(ctx, q, k, v, g, beta, state, NULL, NULL);
+    result->src[6] = fac_all;
+    result->src[7] = n_replay;
+    result->src[8] = fac_ids;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_gated_delta_net_replay(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * state,
+        struct ggml_tensor  * fac,
+        struct ggml_tensor  * n_replay) {
+    GGML_ASSERT(state->type == GGML_TYPE_F32 && ggml_is_contiguous(state));
+    GGML_ASSERT(fac->type == GGML_TYPE_F32 && ggml_is_contiguous(fac));
+    GGML_ASSERT(n_replay->type == GGML_TYPE_I32);
+
+    const int64_t S_v    = state->ne[0];
+    const int64_t H      = state->ne[2];
+    const int64_t n_seqs = state->ne[3];
+    GGML_ASSERT(state->ne[1] == S_v);
+    GGML_ASSERT(fac->ne[2] == n_seqs && ggml_nelements(n_replay) == n_seqs);
+    // the k part holds S_v rows per k head
+    GGML_ASSERT(fac->ne[0] - S_v * H - 2 * H > 0 && (fac->ne[0] - S_v * H - 2 * H) % S_v == 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S_v, S_v, H, n_seqs);
+
+    result->op     = GGML_OP_GATED_DELTA_NET_REPLAY;
+    result->src[0] = state;
+    result->src[1] = fac;
+    result->src[2] = n_replay;
+
+    return result;
+}
