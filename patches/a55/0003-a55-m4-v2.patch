+#pragma once
+#include "common.cuh"
+// Llama-Frankenstein: MXFP4 "direct path" GEMM for RDNA4 prefill (written by Claude).
+// GGML_LF_MXFP4_DIRECT=blaslt | fp8 | f16 turns it on (unset: off, nothing changes):
+//   blaslt  each weight is copied to fp8 e4m3 (exact per block, per-row power-of-two shift) and multiplied by hipBLASLt's fp8
+//           GEMM; activations fp8 with one scale per batch, converted once per input and graph (the fastest mode)
+//   fp8/f16 the same conversion inside this file's own WMMA GEMM kernels (activation scale per token)
+// GGML_LF_MXFP4_MIN_T (default 64) is the smallest token count it takes (decode / verify never reach it);
+// GGML_LF_MXFP4_ALGOS (blaslt): unset = the built-in gfx1201 fp8 priority list (no timing, the same choice every run),
+// heur = hipBLASLt's first heuristic candidate, timed = time the candidates on the first whole batch (old; can differ
+// from run to run); GGML_LF_MXFP4_LOG=1 prints one line per weight tensor / algorithm choice.
+// The MXFP4 block scale is a power of two, so each block converts exactly into fp8 e4m3 / f16 and the scale folds
+// into the weights: one WMMA accumulation over the whole K and one epilogue per output (no per-32 float epilogue).
+// Activations are fp8 e4m3 (one scale per token) or f16 (one power-of-two scale per token), so results differ from
+// mmq (int8 per-32 activations).
+bool ggml_cuda_lf_mxfp4_supported(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst);
+void ggml_cuda_lf_mxfp4_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+// start of a graph: the fp8 activations shared by the MUL_MATs of one graph are invalid from here on
+void ggml_cuda_lf_mxfp4_graph_begin();
+// the fusions that would take an MXFP4 prefill matmul (dense gate+up pair, swiglu -> mmq down) stand down for this path
+bool ggml_cuda_lf_mxfp4_will_take(const ggml_tensor * mm);
