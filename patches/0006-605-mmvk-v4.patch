+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -87,6 +87,7 @@
 #include "ggml-cuda/fill.cuh"
 #include "ggml-cuda/lightning-indexer.cuh"
 #include "ggml-cuda/ggml-cuda-try-fuse.cuh"
+#include "ggml-cuda/mmvk.cuh"
