+// the sum of the eight fp8 values lf_pack_fp8 wrote, in fp32: the row sum must count each probability as the fp8 P.V WMMA
+// sees it.  Summed from the fp32 values instead, a weight below the smallest fp8 subnormal (about 2^-18 of the row's
+// running max) counted in l but not in O, so the output came out systematically small, more so the longer the context.
+static __device__ __forceinline__ float lf_sum_fp8(const uint2 w) {
+#if defined(RDNA4)
+    const int a = (int) w.x, b = (int) w.y;
+    return ((__builtin_amdgcn_cvt_f32_fp8(a, 0) + __builtin_amdgcn_cvt_f32_fp8(a, 1)) +
+            (__builtin_amdgcn_cvt_f32_fp8(a, 2) + __builtin_amdgcn_cvt_f32_fp8(a, 3))) +
+           ((__builtin_amdgcn_cvt_f32_fp8(b, 0) + __builtin_amdgcn_cvt_f32_fp8(b, 1)) +
+            (__builtin_amdgcn_cvt_f32_fp8(b, 2) + __builtin_amdgcn_cvt_f32_fp8(b, 3)));
+#else
+    GGML_UNUSED(w);
+    return 0.f;
+#endif // defined(RDNA4)
+}
