+
+// anchored rollback (llama_memory_recurrent::anchor): the ssm state has plane 0 (the state after the cell's last batch)
+// and plane 1 (the state that batch started from), and the cell's last batch left its replay factors in a factor row.
+// The batch starts from plane 0, or, after a partial rollback, from plane 1 with the accepted tokens replayed; it writes
+// its start state to plane 1, its final state to plane 0 and its factors to the cell's other factor row.  A batch longer
+// than a factor row (a prefill) replays first and runs the snapshot op unchanged (so the chunked prefill with its
+// sequential tail gives the same final state), keeping no factors: it cannot be rolled back into.
+ggml_tensor * llm_build_delta_net_base::build_recurrent_attn_anchor(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        ssm_states_all,
+        ggml_tensor *        q,
+        ggml_tensor *        k,
+        ggml_tensor *        v,
+        ggml_tensor *        g,
+        ggml_tensor *        b,
+        int64_t              K,
+        int                  il) {
+    const auto * mctx_cur = inp->mctx;
+    const int64_t kv_head  = mctx_cur->get_head();
+    const int64_t mem_size = mctx_cur->get_size();
+    const int64_t n_rs     = mctx_cur->get_n_rs();
+    const int32_t rs_zero  = mctx_cur->get_rs_z();
+
+    const int64_t S_v          = v->ne[0];
+    const int64_t H_v          = v->ne[1];
+    const int64_t n_seq_tokens = v->ne[2];
+    const int64_t n_seqs       = v->ne[3];
+    const int64_t D            = S_v * S_v * H_v;
+    const int64_t n_fac        = mctx_cur->get_n_fac();
+    const int64_t fac_rows     = mctx_cur->get_fac_rows();
+
+    ggml_tensor * f_all  = mctx_cur->get_f_l(il);
+    ggml_tensor * states = ggml_reshape_2d(ctx0, ssm_states_all, D, ssm_states_all->ne[1]);
+
+    // the zeroed state of new cells (plane 0), as build_rs does
+    ggml_tensor * state_zero = ggml_view_1d(ctx0, states, D*(rs_zero >= 0), rs_zero*states->nb[1]*(rs_zero >= 0));
+    ggml_build_forward_expand(gf, ggml_scale_inplace(ctx0, state_zero, 0));
+
+    const size_t i32 = ggml_element_size(inp->a_rows);
+    ggml_tensor * rows     = ggml_view_1d(ctx0, inp->a_rows,    n_seqs, 0);
+    ggml_tensor * replay   = ggml_view_1d(ctx0, inp->a_replay,  n_seqs, 0);
+    ggml_tensor * fac_src  = ggml_view_1d(ctx0, inp->a_fac_src, n_seqs, 0);
+    ggml_tensor * fac_dst  = ggml_view_1d(ctx0, inp->a_fac_dst, n_seqs, 0);
+
+    // cells of the range outside the ubatch (moved by find_slot): replay any pending rollback into plane 0 of their
+    // new row, and take their start state (plane 1, the first rows of s_copy_extra) and factors along.  Their rows
+    // and factors are read before this ubatch's cells write the cache (a moved cell may come from a row one of them
+    // writes) ...
+    ggml_tensor * st_x    = nullptr;
+    ggml_tensor * start_x = nullptr;
+    ggml_tensor * fac_x   = nullptr;
+    if (n_rs > n_seqs) {
+        const int64_t n_x = n_rs - n_seqs;
+        ggml_tensor * rows_x = ggml_view_1d(ctx0, inp->a_rows,    n_x, n_seqs * i32);
+        ggml_tensor * rep_x  = ggml_view_1d(ctx0, inp->a_replay,  n_x, n_seqs * i32);
+        ggml_tensor * fsrc_x = ggml_view_1d(ctx0, inp->a_fac_src, n_x, n_seqs * i32);
+        ggml_tensor * s_x    = ggml_reshape_4d(ctx0, ggml_get_rows(ctx0, states, rows_x), S_v, S_v, H_v, n_x);
+        fac_x = ggml_get_rows(ctx0, f_all, fsrc_x);
+        st_x  = ggml_gated_delta_net_replay(ctx0, s_x, ggml_reshape_3d(ctx0, fac_x, n_fac, fac_rows, n_x), rep_x);
+        ggml_build_forward_expand(gf, st_x);
+        start_x = ggml_get_rows(ctx0, states, ggml_view_1d(ctx0, inp->s_copy_extra, n_x, 0));
+        ggml_build_forward_expand(gf, start_x);
+    }
+
+    ggml_tensor * s   = ggml_reshape_4d(ctx0, ggml_get_rows(ctx0, states, rows), S_v, S_v, H_v, n_seqs);
+    ggml_tensor * fac = ggml_reshape_3d(ctx0, ggml_get_rows(ctx0, f_all, fac_src), n_fac, fac_rows, n_seqs);
+    cb(s, "state_predelta", il);
+
+    const size_t row_size = ggml_row_size(ssm_states_all->type, D);
+    ggml_tensor * plane0 = ggml_view_2d(ctx0, states, D, n_seqs, states->nb[1], (size_t) kv_head * row_size);
+    ggml_tensor * plane1 = ggml_view_2d(ctx0, states, D, n_seqs, states->nb[1], (size_t) (mem_size + kv_head) * row_size);
+
+    ggml_tensor * output;
+    if (n_seq_tokens <= fac_rows) {
+        // the factor rows are read by id in the op (no gather of the whole rows)
+        ggml_tensor * gdn = ggml_gated_delta_net_anchor_rows(ctx0, q, k, v, g, b, s, f_all, fac_src, replay);
+        res->add_fused_node({n_seq_tokens > 1 ? LLM_FUSED_OP_GDN_CH : LLM_FUSED_OP_GDN_AR, gdn, il});
+
+        const int64_t n_attn = S_v * H_v * n_seq_tokens * n_seqs;
+        output = ggml_view_4d(ctx0, gdn, S_v, H_v, n_seq_tokens, n_seqs,
+                ggml_row_size(gdn->type, S_v), ggml_row_size(gdn->type, S_v * H_v),
+                ggml_row_size(gdn->type, S_v * H_v * n_seq_tokens), 0);
+        ggml_tensor * start  = ggml_view_2d(ctx0, gdn, D, n_seqs, ggml_row_size(gdn->type, D), ggml_row_size(gdn->type, n_attn));
+        ggml_tensor * fin    = ggml_view_2d(ctx0, gdn, D, n_seqs, ggml_row_size(gdn->type, D), ggml_row_size(gdn->type, n_attn + D * n_seqs));
+        ggml_tensor * fac_o  = ggml_view_2d(ctx0, gdn, n_fac * n_seq_tokens, n_seqs, ggml_row_size(gdn->type, n_fac * n_seq_tokens),
+                ggml_row_size(gdn->type, n_attn + 2 * D * n_seqs));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, start, plane1));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, fin,   plane0));
+        // the factor rows hold fac_rows tokens; this batch fills the first n_seq_tokens
+        ggml_tensor * f_dst = ggml_view_2d(ctx0, f_all, n_fac * n_seq_tokens, f_all->ne[1], f_all->nb[1], 0);
+        ggml_build_forward_expand(gf, ggml_set_rows(ctx0, f_dst, fac_o, fac_dst));
+    } else {
+        ggml_tensor * start = ggml_gated_delta_net_replay(ctx0, s, fac, replay);
+        ggml_tensor * gdn   = ggml_gated_delta_net(ctx0, q, k, v, g, b, start, K, cparams.n_rs_batch);
+        res->add_fused_node({LLM_FUSED_OP_GDN_CH, gdn, il});
+
+        output = ggml_view_4d(ctx0, gdn, S_v, H_v, n_seq_tokens, n_seqs,
+                ggml_row_size(gdn->type, S_v), ggml_row_size(gdn->type, S_v * H_v),
+                ggml_row_size(gdn->type, S_v * H_v * n_seq_tokens), 0);
+        // snapshot slot 0 is the final state
+        ggml_tensor * fin = ggml_view_2d(ctx0, gdn, D, n_seqs, ggml_row_size(gdn->type, D),
+                ggml_row_size(gdn->type, S_v * H_v * n_seq_tokens * n_seqs));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, fin, plane0));
+    }
+    cb(output, "attn_output", il);
+
+    // ... and are written after this ubatch's cells were read
+    if (st_x != nullptr) {
+        const int64_t n_x = n_rs - n_seqs;
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_reshape_2d(ctx0, st_x, D, n_x),
+                ggml_view_2d(ctx0, states, D, n_x, states->nb[1], (size_t) (kv_head + n_seqs) * row_size)));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, start_x,
+                ggml_view_2d(ctx0, states, D, n_x, states->nb[1], (size_t) (mem_size + kv_head + n_seqs) * row_size)));
+        ggml_build_forward_expand(gf, ggml_set_rows(ctx0, f_all, fac_x, ggml_view_1d(ctx0, inp->a_fac_dst, n_x, n_seqs * i32)));
+    }
+
+    return output;
+}
