diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index 7aa601e5a..0802202c0 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -7,7 +7,26 @@
 
 constexpr int gdn_cols_per_warp = 4;
 
-template <int S_v, bool KDA, bool keep_rs_t, int cols_per_warp = gdn_cols_per_warp>
+// anchored rollback (ggml_gated_delta_net_anchor / _replay): replay n_replay[seq] tokens of the previous batch's factors
+// onto the state before the batch's tokens, and write each token's factors.  A factor row is [v (S_v x H) | k (S_v x
+// H_k) | decay (H) | beta (H)], the values the token update read (the decay after expf, beta after the sigmoid).
+struct ggml_cuda_gdn_anchor_args {
+    const float   * fac_in     = nullptr; // [n_fac, rows, n_seqs] or nullptr
+    const int32_t * fac_in_ids = nullptr; // set: sequence s reads row fac_in_ids[s] of fac_in, fac_in_seq floats apart
+    const int32_t * n_replay   = nullptr; // [n_seqs] or nullptr
+    int64_t         fac_in_seq = 0;       // floats per sequence of fac_in
+    float         * start_out  = nullptr; // the state after the replay, [D, n_seqs] (nullptr: not written)
+    float         * fac_out    = nullptr; // [n_fac, n_tokens, n_seqs] (nullptr: not written)
+    const int32_t * fac_ids    = nullptr; // fused into the cache: the factor row of each sequence in fac_out
+    int64_t         fac_stride = 0;       // floats between those rows
+    int64_t         n_fac      = 0;
+    int64_t         H_k        = 0;
+};
+
+// nt: the input state is read and the per-token snapshots are written with non-temporal hints (same values).  A verify step
+// writes one snapshot per token (6 slots x 48 layers, ~0.86 GB per step on Qwen3.8-27B) that is not read again before the
+// next step; with plain stores it pushes the next GEMMs' data out of the last-level cache.
+template <int S_v, bool KDA, bool keep_rs_t, int cols_per_warp = gdn_cols_per_warp, bool nt = false, bool anchor = false>
 __global__ void __launch_bounds__((ggml_cuda_get_physical_warp_size() < S_v ? ggml_cuda_get_physical_warp_size() : S_v) * 4, 2)
 gated_delta_net_cuda(const float * q,
                                      const float * k,
@@ -36,7 +55,9 @@ gated_delta_net_cuda(const float * q,
                                      int           K,
                                      int           beta_sigmoid,
                                      const int32_t * s_ids,
-                                     int64_t       s_row_stride) {
+                                     int64_t       s_row_stride,
+                                     const ggml_cuda_gdn_anchor_args aa) {
+    static_assert(!anchor || (!KDA && !keep_rs_t), "the anchored kernel is the scalar-gate final-state kernel");
     const uint32_t h_idx    = blockIdx.x;
     const uint32_t sequence = blockIdx.y;
 
@@ -79,7 +100,58 @@ gated_delta_net_cuda(const float * q,
 #pragma unroll
     for (int r = 0; r < rows_per_lane; r++) {
         const int i = r * lanes_per_col + lane_in_col;
-        s_shard[r]  = curr_state[i];
+        if constexpr (nt) {
+            s_shard[r] = __builtin_nontemporal_load(&curr_state[i]);
+        } else {
+            s_shard[r] = curr_state[i];
+        }
+    }
+
+    if constexpr (anchor) {
+        // the token update of the loop below (same expressions, so the same state bit for bit), without the attention
