diff --git a/ggml/src/ggml-cuda/mmvk.cu b/ggml/src/ggml-cuda/mmvk.cu
new file mode 100644
index 000000000..317916f35
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvk.cu
@@ -0,0 +1,410 @@
+#include "mmvk.cuh"
+#include "quantize.cuh"
+#include "vecdotq.cuh"
+#include <atomic>
+#include <cstdio>
+#include <type_traits>
+#include <cstring>
+#include <unordered_set>
+
+namespace {
+
+// GGML_CUDA_MMVK: 1 = single launches, 2 = same-input groups, both only when the program verifies speculative drafts
+// (ggml_backend_set_speculative_decoding, called by llama-server before it loads the models); 3 / 4 = the same, always;
+// 0 = off.  Unset: 2 (GGML_LF_ALL=0: off).
+bool mmvk_explicit() {
+    static const bool x = getenv("GGML_CUDA_MMVK") != nullptr;
+    return x;
+}
+
+int mmvk_mode() {
+    static const int m = [] {
+        if (mmvk_explicit()) return atoi(getenv("GGML_CUDA_MMVK"));
+        const char * a = getenv("GGML_LF_ALL");
+        return a != nullptr && a[0] == '0' && a[1] == '\0' ? 0 : 2;
+    }();
+    return m;
+}
+
+std::atomic<bool> mmvk_speculative{false};
+
+bool mmvk_on() {
+    const int m = mmvk_mode();
+    return m == 3 || m == 4 || ((m == 1 || m == 2) && mmvk_speculative.load(std::memory_order_relaxed));
+}
+
+// GGML_CUDA_MMVK_EXT (bit mask, default 1): 1 = groups may mix weight types (bit-identical to same-type groups),
+// 2 = also IQ4_XS / IQ4_NL / MXFP4 (their stock kernel already holds ~97% of the bandwidth at 6 columns: no gain on
+// UD-Q4_K_XL, values change; opt-in)
+int mmvk_ext() {
+    static const int e = getenv("GGML_CUDA_MMVK_EXT") ? atoi(getenv("GGML_CUDA_MMVK_EXT")) : 1;
+    return e;
+}
+
+constexpr int MMVK_LPR = 32;     // lanes per row group: fixed -- it sets the per-output summation order
+constexpr int MMVK_GMAX = 8;
+
+__device__ __forceinline__ int mmvk_ld32(const uint8_t * p) { int v; __builtin_memcpy(&v, p, 4); return v; }
+
+__device__ __forceinline__ void mmvk_scale_min_k4(const int j, const uint8_t * q, int & sc, int & m) {
+    if (j < 4) { sc = q[j] & 63; m = q[j + 4] & 63; }
+    else       { sc = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4); m = (q[j + 4] >> 4) | ((q[j] >> 6) << 4); }
+}
+
+bool mmvk_type_ok(const ggml_type t) {
+    return t == GGML_TYPE_Q4_K || t == GGML_TYPE_Q5_K || t == GGML_TYPE_Q6_K ||
+           ((mmvk_ext() & 2) && (t == GGML_TYPE_IQ4_XS || t == GGML_TYPE_IQ4_NL || t == GGML_TYPE_MXFP4));
+}
+
+bool mmvk_same_group(const ggml_tensor * a, const ggml_tensor * b) {
+    return b->op == GGML_OP_MUL_MAT && b->src[1] == a->src[1] && ((mmvk_ext() & 1) || b->src[0]->type == a->src[0]->type);
+}
+
+// rows per lane group (RW) and warps per block; GGML_TYPE_COUNT = a mixed-type group (every member at RW 2, WARPS 2)
+template <ggml_type type> struct mmvk_cfg { static constexpr int RW = 2, WARPS = 2; };
+template <> struct mmvk_cfg<GGML_TYPE_Q6_K> { static constexpr int RW = 4, WARPS = 4; };
+template <> struct mmvk_cfg<GGML_TYPE_IQ4_XS> { static constexpr int RW = 4, WARPS = 2; };
+template <> struct mmvk_cfg<GGML_TYPE_IQ4_NL> { static constexpr int RW = 4, WARPS = 2; };
+
+struct mmvk_args {
+    const uint8_t * W[MMVK_GMAX];
+    float *         D[MMVK_GMAX];
+    int             M[MMVK_GMAX];
+    int             type[MMVK_GMAX];
+    int             block_start[MMVK_GMAX + 1];
+    int64_t         row_bytes[MMVK_GMAX];
+    int64_t         stride_col_dst[MMVK_GMAX];  // in floats
+    int             n;
+};
+
+// RW rows of one matrix against NC columns; the lane walks the 32-value sub-blocks u = lane, lane + 32, ... of the row.
+// The per-output order (sub-blocks per lane, then the 32-lane butterfly) depends on neither NC nor RW.
+template <ggml_type T, int NC, int RW>
+__device__ __forceinline__ void mmvk_rows(const uint8_t * __restrict__ W, float * __restrict__ out, const int M, const int64_t row_bytes,
+                                             const int64_t stride_col_dst, const int row0, const int lane,
+                                             const block_q8_1 * __restrict__ Y, const int nsub, const int64_t stride_col_y) {
+    constexpr bool need_ys = T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K || T == GGML_TYPE_Q6_K;
+    float acc[RW][NC];
+#pragma unroll
+    for (int r = 0; r < RW; ++r)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) acc[r][c] = 0.f;
+    for (int u = lane; u < nsub; u += MMVK_LPR) {
+        const int kb = u >> 3, j = u & 7;
+        int ya[NC][8]; float yd[NC]; int ys0[NC], ys1[NC];
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            const block_q8_1 * y = Y + c * stride_col_y + u;
+            yd[c] = __low2float(y->ds);
+            int s0 = 0, s1 = 0;
+#pragma unroll
+            for (int l = 0; l < 8; ++l) {
+                ya[c][l] = ((const int *) y->qs)[l];
+                if constexpr (need_ys) {
+                    if (l < 4) s0 = ggml_cuda_dp4a(0x01010101, ya[c][l], s0); else s1 = ggml_cuda_dp4a(0x01010101, ya[c][l], s1);
+                }
+            }
+            ys0[c] = s0; ys1[c] = s1;
+        }
+#pragma unroll
+        for (int r = 0; r < RW; ++r) {
+            const int row = row0 + r;
+            if (row >= M) break;
+            const uint8_t * rowp = W + (int64_t) row * row_bytes;
+            if constexpr (T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K) {
+                using B = std::conditional_t<T == GGML_TYPE_Q4_K, block_q4_K, block_q5_K>;
+                const B * b = (const B *) rowp + kb;
+                const float2 dm = __half22float2(b->dm);
+                int sc, m;
+                mmvk_scale_min_k4(j, b->scales, sc, m);
+                const int shift = 4 * (j & 1);
+                int v[8];
+#pragma unroll
+                for (int l = 0; l < 8; ++l) {
+                    v[l] = (mmvk_ld32(b->qs + 32 * (j >> 1) + 4 * l) >> shift) & 0x0F0F0F0F;
+                    if constexpr (T == GGML_TYPE_Q5_K) v[l] |= ((mmvk_ld32(b->qh + 4 * l) >> j) & 0x01010101) << 4;
+                }
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    int s = 0;
+#pragma unroll
+                    for (int l = 0; l < 8; ++l) s = ggml_cuda_dp4a(v[l], ya[c][l], s);
+                    acc[r][c] += yd[c] * (dm.x * (float) (sc * s) - dm.y * (float) (m * (ys0[c] + ys1[c])));
+                }
+            } else if constexpr (T == GGML_TYPE_Q6_K) {
+                // sub-block t = j & 3 of half h = j >> 2; ql bytes 64h + 32(t & 1) (low nibbles for t < 2), qh bytes 32h
+                // bits 2t..2t+1, scales 8h + 2t (first 16 values) and 8h + 2t + 1; value = d * scale * (q - 32)
+                const block_q6_K * b = (const block_q6_K *) rowp + kb;
+                const int h = j >> 2, t = j & 3;
+                const float d = __half2float(b->d);
+                const int sa = b->scales[8 * h + 2 * t], sb = b->scales[8 * h + 2 * t + 1];
+                const int nshift = t < 2 ? 0 : 4, hshift = 2 * t;
+                int v[8];
+#pragma unroll
+                for (int l = 0; l < 8; ++l) {
+                    const int lo = (mmvk_ld32(b->ql + 64 * h + 32 * (t & 1) + 4 * l) >> nshift) & 0x0F0F0F0F;
+                    const int hi = (mmvk_ld32(b->qh + 32 * h + 4 * l) >> hshift) & 0x03030303;
+                    v[l] = lo | (hi << 4);
+                }
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    int s0 = 0, s1 = 0;
+#pragma unroll
+                    for (int l = 0; l < 4; ++l) s0 = ggml_cuda_dp4a(v[l], ya[c][l], s0);
+#pragma unroll
+                    for (int l = 4; l < 8; ++l) s1 = ggml_cuda_dp4a(v[l], ya[c][l], s1);
+                    acc[r][c] += yd[c] * d * (float) (sa * (s0 - 32 * ys0[c]) + sb * (s1 - 32 * ys1[c]));
+                }
+            } else {
+                // 16 bytes of nibbles per 32 values (low nibble = value l, high = 16 + l) through a 16-entry table
+                const uint8_t * qs; const int8_t * table; float d;
+                if constexpr (T == GGML_TYPE_IQ4_XS) {
+                    const block_iq4_xs * b = (const block_iq4_xs *) rowp + kb;
+                    const int ls = ((b->scales_l[j >> 1] >> (4 * (j & 1))) & 0x0F) | (((b->scales_h >> (2 * j)) & 0x03) << 4);
+                    qs = b->qs + 16 * j; table = kvalues_iq4nl; d = __half2float(b->d) * (float) (ls - 32);
+                } else if constexpr (T == GGML_TYPE_IQ4_NL) {
+                    const block_iq4_nl * b = (const block_iq4_nl *) rowp + u;
+                    qs = b->qs; table = kvalues_iq4nl; d = __half2float(b->d);
+                } else {
+                    static_assert(T == GGML_TYPE_MXFP4, "mmvk: type");
+                    const block_mxfp4 * b = (const block_mxfp4 *) rowp + u;
+                    qs = b->qs; table = kvalues_mxfp4; d = ggml_cuda_e8m0_to_fp32(b->e) * 0.5f;
+                }
+                int2 v[4];
+#pragma unroll
+                for (int l = 0; l < 4; ++l) v[l] = get_int_from_table_16(mmvk_ld32(qs + 4 * l), table);
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    int s = 0;
+#pragma unroll
+                    for (int l = 0; l < 4; ++l) {
+                        s = ggml_cuda_dp4a(v[l].x, ya[c][l], s);
+                        s = ggml_cuda_dp4a(v[l].y, ya[c][l + 4], s);
+                    }
+                    acc[r][c] += yd[c] * d * (float) s;
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < RW; ++r)
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            float a = acc[r][c];
+#pragma unroll
+            for (int o = MMVK_LPR / 2; o > 0; o >>= 1) a += __shfl_xor(a, o, 32);
+            acc[r][c] = a;
+        }
+    for (int e = lane; e < RW * NC; e += MMVK_LPR) {
+        const int r = e / NC, c = e % NC;
+        float val = 0.f;
+#pragma unroll
+        for (int rr = 0; rr < RW; ++rr)
+#pragma unroll
+            for (int cc = 0; cc < NC; ++cc) if (rr == r && cc == c) val = acc[rr][cc];
+        if (row0 + r < M) out[c * stride_col_dst + row0 + r] = val;
+    }
+}
+
+// one launch over the rows of 1..MMVK_GMAX matrices that share the q8_1 activations Y; type = GGML_TYPE_COUNT: members of
+// different types (the switch is uniform per block)
+template <ggml_type type, int NC>
+__launch_bounds__(32 * mmvk_cfg<type>::WARPS)
+__global__ void mmvk_kernel(const mmvk_args args, const block_q8_1 * __restrict__ Y, const int nsub, const int64_t stride_col_y) {
+    constexpr int RW = mmvk_cfg<type>::RW, WARPS = mmvk_cfg<type>::WARPS, GPW = 32 / MMVK_LPR;
+    int g = 0;
+#pragma unroll
+    for (int k = 1; k < MMVK_GMAX; ++k) g += (k < args.n && (int) blockIdx.x >= args.block_start[k]) ? 1 : 0;
+    const int bx = blockIdx.x - args.block_start[g];
+    const int lane = threadIdx.x % MMVK_LPR, grp = threadIdx.x / MMVK_LPR;
+    const int row0 = (bx * WARPS * GPW + grp) * RW;
+    const int M = args.M[g];
+    if (row0 >= M) return;
+#define MMVK_ROWS(T) mmvk_rows<T, NC, RW>(args.W[g], args.D[g], M, args.row_bytes[g], args.stride_col_dst[g], row0, lane, Y, nsub, stride_col_y)
+    if constexpr (type != GGML_TYPE_COUNT) {
+        MMVK_ROWS(type);
+    } else {
+        switch (args.type[g]) {
+            case GGML_TYPE_Q4_K:   MMVK_ROWS(GGML_TYPE_Q4_K);   break;
+            case GGML_TYPE_Q5_K:   MMVK_ROWS(GGML_TYPE_Q5_K);   break;
+            case GGML_TYPE_Q6_K:   MMVK_ROWS(GGML_TYPE_Q6_K);   break;
+            case GGML_TYPE_IQ4_XS: MMVK_ROWS(GGML_TYPE_IQ4_XS); break;
+            case GGML_TYPE_IQ4_NL: MMVK_ROWS(GGML_TYPE_IQ4_NL); break;
+            case GGML_TYPE_MXFP4:  MMVK_ROWS(GGML_TYPE_MXFP4);  break;
+            default: break;
+        }
+    }
+#undef MMVK_ROWS
+}
+
+template <ggml_type type>
+void mmvk_launch(const mmvk_args & args, const int blocks, const block_q8_1 * Y, const int nsub, const int64_t stride_col_y,
+                    const int ncols, cudaStream_t stream) {
+    const dim3 grid(blocks), block(32 * mmvk_cfg<type>::WARPS);
+    switch (ncols) {
+        case 1: mmvk_kernel<type, 1><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 2: mmvk_kernel<type, 2><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 3: mmvk_kernel<type, 3><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 4: mmvk_kernel<type, 4><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 5: mmvk_kernel<type, 5><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 6: mmvk_kernel<type, 6><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 7: mmvk_kernel<type, 7><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        case 8: mmvk_kernel<type, 8><<<grid, block, 0, stream>>>(args, Y, nsub, stride_col_y); break;
+        default: GGML_ABORT("mmvk: unsupported ncols %d", ncols);
+    }
+}
+
+int mmvk_rows_per_block(const ggml_type t) {
+    switch (t) {
+        case GGML_TYPE_Q6_K:  return mmvk_cfg<GGML_TYPE_Q6_K>::RW * mmvk_cfg<GGML_TYPE_Q6_K>::WARPS * (32 / MMVK_LPR);
+        case GGML_TYPE_IQ4_XS: return mmvk_cfg<GGML_TYPE_IQ4_XS>::RW * mmvk_cfg<GGML_TYPE_IQ4_XS>::WARPS * (32 / MMVK_LPR);
+        case GGML_TYPE_IQ4_NL: return mmvk_cfg<GGML_TYPE_IQ4_NL>::RW * mmvk_cfg<GGML_TYPE_IQ4_NL>::WARPS * (32 / MMVK_LPR);
+        default:              return mmvk_cfg<GGML_TYPE_COUNT>::RW * mmvk_cfg<GGML_TYPE_COUNT>::WARPS * (32 / MMVK_LPR);
+    }
+}
+
+// quantize src1 once per graph (the MMVQ q8_1 cache), run the group
+void mmvk_run(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, const int n) {
+    const ggml_tensor * a = nodes[0];
+    const ggml_tensor * src1 = a->src[1];
+    const ggml_type type = a->src[0]->type;
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne10 = src1->ne[0], ne11 = src1->ne[1];
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const size_t q8_size = ne11 * ne10_padded * sizeof(block_q8_1) / QK8_1;
+    const ggml_tensor * key = src1;
+    while (key->view_src != nullptr) key = key->view_src;
+    const int64_t s11 = src1->nb[1] / sizeof(float), s12 = src1->nb[2] / sizeof(float), s13 = src1->nb[3] / sizeof(float);
+    bool cached = false;
+    void * y = ctx.q8_1_cache_get(key, ctx.curr_stream_no, q8_size, ne10, ne11, 1, 1, s11, s12, s13, cached);
+    if (!cached) {
+        quantize_row_q8_1_cuda((const float *) src1->data, nullptr, y, type, ne10, s11, s12, s13, ne10_padded, ne11, 1, 1, stream);
+    }
+    bool mixed = false;
+    for (int g = 1; g < n; ++g) mixed |= nodes[g]->src[0]->type != type;
+    const int rpb = mixed ? mmvk_rows_per_block(GGML_TYPE_COUNT) : mmvk_rows_per_block(type);
+    mmvk_args args{};
+    args.n = n;
+    int blocks = 0;
+    for (int g = 0; g < n; ++g) {
+        const ggml_tensor * d = nodes[g];
+        const ggml_tensor * w = d->src[0];
+        args.W[g] = (const uint8_t *) w->data;
+        args.D[g] = (float *) d->data;
+        args.M[g] = (int) w->ne[1];
+        args.type[g] = (int) w->type;
+        args.row_bytes[g] = w->nb[1];
+        args.stride_col_dst[g] = d->nb[1] / sizeof(float);
+        args.block_start[g] = blocks;
+        blocks += (int) ((w->ne[1] + rpb - 1) / rpb);
+    }
+    args.block_start[n] = blocks;
+    const int nsub = (int) (a->src[0]->ne[0] / QK8_1);
+    const int64_t stride_col_y = ne10_padded / QK8_1;
+    const block_q8_1 * Y = (const block_q8_1 *) y;
+    switch (mixed ? GGML_TYPE_COUNT : type) {
+        case GGML_TYPE_Q4_K:   mmvk_launch<GGML_TYPE_Q4_K>  (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_Q5_K:   mmvk_launch<GGML_TYPE_Q5_K>  (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_Q6_K:   mmvk_launch<GGML_TYPE_Q6_K>  (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_IQ4_XS: mmvk_launch<GGML_TYPE_IQ4_XS>(args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_IQ4_NL: mmvk_launch<GGML_TYPE_IQ4_NL>(args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_MXFP4:  mmvk_launch<GGML_TYPE_MXFP4> (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        case GGML_TYPE_COUNT:  mmvk_launch<GGML_TYPE_COUNT> (args, blocks, Y, nsub, stride_col_y, (int) ne11, stream); break;
+        default: GGML_ABORT("mmvk: type");
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool mmvk_member_ok(const ggml_tensor * n) {
+    return n->op == GGML_OP_MUL_MAT && ggml_cuda_mmvk_takes(n->src[0], n->src[1], n) && ggml_is_contiguous(n) &&
+        n->src[0]->buffer != nullptr && ggml_backend_buffer_get_usage(n->src[0]->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE;
+}
+
+} // namespace
+
+bool ggml_cuda_mmvk_type(const ggml_type type) {
+    return mmvk_on() && mmvk_type_ok(type) && GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ggml_cuda_get_device()].cc);
+}
+
+bool ggml_cuda_mmvk_takes(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (!ggml_cuda_mmvk_type(src0->type)) return false;
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) return false;
+    if (src1->ne[1] < 1 || src1->ne[1] > 8 || src0->ne[0] % ggml_blck_size(src0->type) != 0 || src1->ne[0] != src0->ne[0]) return false;
+    if (!ggml_is_contiguous(src0) || src1->nb[0] != sizeof(float) || dst->nb[0] != sizeof(float) || src0->view_src) return false;
+    return true;
+}
+
+void ggml_cuda_mmvk_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    GGML_UNUSED(src0); GGML_UNUSED(src1);
+    ggml_tensor * nodes[1] = { dst };
+    mmvk_run(ctx, nodes, 1);
+}
+
+bool ggml_cuda_mmvk_group_on() { return mmvk_on() && (mmvk_mode() == 2 || mmvk_mode() == 4); }
+
+const char * ggml_cuda_mmvk_set_speculative(const bool on) {
+    mmvk_speculative.store(on, std::memory_order_relaxed);
+    const int m = mmvk_mode();
+    if (m == 0) {
+        return nullptr;
+    }
+    bool rdna4 = false;
+    for (int d = 0; d < ggml_cuda_info().device_count; ++d) {
+        rdna4 |= GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[d].cc);
+    }
+    static char msg[160];
+    if (m < 0 || m > 4) {
+        snprintf(msg, sizeof(msg), "mmvk: GGML_CUDA_MMVK=%d not recognized (1..4), off", m);
+    } else if (!rdna4) {
+        if (!mmvk_explicit()) {
+            return nullptr; // the default, on a GPU it does not run on: nothing to report
+        }
+        snprintf(msg, sizeof(msg), "mmvk: GGML_CUDA_MMVK=%d, but no RDNA4 device, off", m);
+    } else if (m >= 3 || on) {
+        snprintf(msg, sizeof(msg), "mmvk on (GGML_CUDA_MMVK=%d%s: %s, %s launches)", m, mmvk_explicit() ? "" : " by default",
+                 m >= 3 ? "always" : "speculative decoding", m % 2 == 0 ? "grouped" : "single");
+    } else {
+        snprintf(msg, sizeof(msg), "mmvk off (GGML_CUDA_MMVK=%d%s: no speculative decoding; 3 / 4 turn it on anyway)", m,
+                 mmvk_explicit() ? "" : " by default");
+    }
+    return msg;
+}
+
+void ggml_cuda_mmvk_group_reorder(ggml_cgraph * cgraph) {
+    // moving a MUL_MAT earlier is safe: its inputs are a weight and the shared src1, computed before the group's first node
+    constexpr int max_distance = 160;
+    std::unordered_set<const ggml_tensor *> taken;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        ggml_tensor * a = cgraph->nodes[i];
+        if (taken.count(a) || !mmvk_member_ok(a)) continue;
+        taken.insert(a);
+        int last = i, n = 1;
+        const int j_end = std::min(cgraph->n_nodes, i + 1 + max_distance);
+        for (int j = i + 1; j < j_end && n < MMVK_GMAX; ++j) {
+            ggml_tensor * b = cgraph->nodes[j];
+            if (taken.count(b) || !mmvk_same_group(a, b) || !mmvk_member_ok(b)) continue;
+            if (j != last + 1) {
+                memmove(cgraph->nodes + last + 2, cgraph->nodes + last + 1, (j - last - 1) * sizeof(ggml_tensor *));
+                cgraph->nodes[last + 1] = b;
+            }
+            taken.insert(b);
+            ++last; ++n;
+        }
+        i = last;
+    }
+}
+
+int ggml_cuda_mmvk_group(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, const int i) {
+    ggml_tensor * a = cgraph->nodes[i];
+    if (!mmvk_member_ok(a)) return 0;
+    int n = 1;
+    while (n < MMVK_GMAX && i + n < cgraph->n_nodes) {
+        const ggml_tensor * b = cgraph->nodes[i + n];
+        if (!mmvk_same_group(a, b) || !mmvk_member_ok(b)) break;
+        ++n;
+    }
+    if (n < 2) return 0;
+    mmvk_run(ctx, cgraph->nodes + i, n);
+    return n;
+}
