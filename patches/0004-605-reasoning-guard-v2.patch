From a358a7779d4dd54e069ba9bb66bb9d80c9617c54 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Tue, 27 Oct 2026 05:40:20 +0800
Subject: [PATCH] common: reasoning guard v2, on by default
 (LLAMA_REASONING_GUARD=0 turns it off)

An end-of-generation token sampled inside the reasoning block is replaced by
the block's end tag, so the model goes on to write the answer instead of
ending the turn with the answer left in the reasoning and the content empty.
On by default (LLAMA_REASONING_GUARD=0 or GGML_LF_ALL=0 turns it off).  Tokens before that point are sampled as before; backend
sampling, speculative verification (match and rejection) and grammars keep
their paths.  Only a single-token end tag is supported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/sampling.cpp | 117 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 114 insertions(+), 3 deletions(-)

diff --git a/common/sampling.cpp b/common/sampling.cpp
index da77044b7..6b6bebc0b 100644
--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -320,8 +320,60 @@ struct common_sampler {
     std::vector<llama_logit_bias> fast_bias = {};                // S2: the chain's logit biases, in the chain's order
     std::vector<llama_token> fast_bias_ids = {};                 // S2: the biased tokens, sorted, unique
     std::vector<std::pair<float, llama_token>> fast_top = {};    // S2: scratch
+
+    // reasoning guard (LLAMA_REASONING_GUARD=1): an end-of-generation token sampled inside the reasoning block is
+    // replaced by the block's end tag.  Ending the turn there leaves the answer inside the reasoning and the content
+    // empty; with the tag the model goes on and writes the answer.  Nothing changes before that point: the token was
+    // sampled as usual, and only an end of generation inside the block is replaced.
+    const llama_vocab *       rguard_vocab = nullptr;  // non-null = on
+    bool                      rguard_in    = false;    // inside the reasoning block
+    llama_token               rguard_end   = LLAMA_TOKEN_NULL;
+    llama_tokens              rguard_start = {};
+    std::vector<llama_tokens> rguard_ends  = {};
+    llama_tokens              rguard_tail  = {};       // the last generated tokens, as many as the longest tag
 };
 
+static bool rguard_tail_matches(const llama_tokens & tail, const llama_tokens & tag) {
+    return !tag.empty() && tail.size() >= tag.size() && std::equal(tag.begin(), tag.end(), tail.end() - tag.size());
+}
+
+static void rguard_track(common_sampler * gsmpl, llama_token token) {
+    auto & tail = gsmpl->rguard_tail;
+    size_t n = gsmpl->rguard_start.size();
+    for (const auto & e : gsmpl->rguard_ends) {
+        n = std::max(n, e.size());
+    }
+    tail.push_back(token);
+    if (tail.size() > n) {
+        tail.erase(tail.begin(), tail.end() - n);
+    }
+    if (rguard_tail_matches(tail, gsmpl->rguard_start)) {
+        gsmpl->rguard_in = true;
+    }
+    for (const auto & e : gsmpl->rguard_ends) {
+        if (rguard_tail_matches(tail, e)) {
+            gsmpl->rguard_in = false;
+        }
+    }
+}
+
+// the token to emit in place of a sampled one: the end tag for an end of generation inside the reasoning block
+static llama_token rguard_apply(common_sampler * gsmpl, llama_token id) {
+    if (!gsmpl->rguard_vocab || !gsmpl->rguard_in || id == LLAMA_TOKEN_NULL || !llama_vocab_is_eog(gsmpl->rguard_vocab, id)) {
+        return id;
+    }
+    LOG_WRN("%s: end of generation (token %d) inside the reasoning block, emitting the end tag (token %d) instead\n",
+            __func__, id, gsmpl->rguard_end);
+    auto & cur_p = gsmpl->cur_p;
+    for (size_t i = 0; i < cur_p.size; ++i) {
+        if (cur_p.data[i].id == gsmpl->rguard_end) {
+            cur_p.selected = i;
+            break;
+        }
+    }
+    return gsmpl->rguard_end;
+}
+
 // S2: the fast path's k when every sampler ahead of top-k is a no-op for these parameters (logit bias is handled by the
 // fast path itself), else 0.  GGML_LF_FAST_TOPK=0 turns it off.
 static int common_sampler_fast_topk_k(const common_params_sampling & p) {
@@ -640,6 +692,39 @@ struct common_sampler * common_sampler_init(
         }
     }
 
+    {
+        // LLAMA_REASONING_GUARD: on unless set to 0 (unset with GGML_LF_ALL=0: off)
+        static const bool on = [] {
+            const char * e = getenv("LLAMA_REASONING_GUARD");
+            if (e != nullptr) return atoi(e) != 0;
+            const char * a = getenv("GGML_LF_ALL");
+            return !(a != nullptr && a[0] == '0' && a[1] == '\0');
+        }();
+        // one token is emitted in place of one token: the last token of the first end tag, when that token is an end tag
+        // by itself (a template may list "\n</think>", "</think>" and "<tool_call>")
+        if (on && !params.reasoning_budget_start.empty() && !params.reasoning_budget_end.empty() && !params.reasoning_budget_end.front().empty()) {
+            static bool logged = false;
+            const llama_token last = params.reasoning_budget_end.front().back();
+            const auto it = std::find(params.reasoning_budget_end.begin(), params.reasoning_budget_end.end(), llama_tokens{ last });
+            if (it != params.reasoning_budget_end.end()) {
+                result->rguard_vocab = vocab;
+                result->rguard_end   = it->front();
+                result->rguard_start = params.reasoning_budget_start;
+                result->rguard_ends  = params.reasoning_budget_end;
+                for (const llama_token t : prefill_tokens) {
+                    rguard_track(result, t);
+                }
+                if (!logged) {
+                    LOG_INF("%s: reasoning guard on (LLAMA_REASONING_GUARD): an end of generation inside the reasoning block "
+                            "is replaced by the end tag (token %d)\n", __func__, result->rguard_end);
+                }
+            } else if (!logged) {
+                LOG_WRN("%s: reasoning guard off: the last token of the reasoning end tag is not an end tag by itself\n", __func__);
+            }
+            logged = true;
+        }
+    }
+
     return result;
 }
 
@@ -702,6 +787,10 @@ void common_sampler_accept(struct common_sampler * gsmpl, llama_token token, boo
     llama_sampler_accept(gsmpl->chain, token);
 
     gsmpl->prev.push_back(token);
+
+    if (gsmpl->rguard_vocab && is_generated) {
+        rguard_track(gsmpl, token);
+    }
 }
 
 void common_sampler_reset(struct common_sampler * gsmpl) {
@@ -726,6 +815,13 @@ struct common_sampler * common_sampler_clone(common_sampler * gsmpl) {
         /* .fast_k  */ gsmpl->fast_k,
         /* .fast_bias */ gsmpl->fast_bias,
         /* .fast_bias_ids */ gsmpl->fast_bias_ids,
+        /* .fast_top */ {},
+        /* .rguard_vocab */ gsmpl->rguard_vocab,
+        /* .rguard_in */ gsmpl->rguard_in,
+        /* .rguard_end */ gsmpl->rguard_end,
+        /* .rguard_start */ gsmpl->rguard_start,
+        /* .rguard_ends */ gsmpl->rguard_ends,
+        /* .rguard_tail */ gsmpl->rguard_tail,
     };
 }
 
@@ -748,6 +844,12 @@ void common_sampler_copy(const common_sampler * src, common_sampler * dst) {
     dst->cur_p.data = src->cur_p.data ? dst->cur.data() : nullptr; // re-point to dst's buffer
     dst->rng        = src->rng;
     dst->t_total_us = src->t_total_us;
+    dst->rguard_vocab = src->rguard_vocab;
+    dst->rguard_in    = src->rguard_in;
+    dst->rguard_end   = src->rguard_end;
+    dst->rguard_start = src->rguard_start;
+    dst->rguard_ends  = src->rguard_ends;
+    dst->rguard_tail  = src->rguard_tail;
 }
 
 void common_perf_print(const struct llama_context * ctx, const struct common_sampler * gsmpl) {
@@ -804,7 +906,7 @@ struct llama_sampler * common_sampler_get(const struct common_sampler * gsmpl) {
     return gsmpl->chain;
 }
 
-llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first) {
+static llama_token common_sampler_sample_impl(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first) {
     llama_synchronize(ctx);
 
     // start measuring sampling time after the llama_context synchronization in order to not measure any ongoing async operations
@@ -893,6 +995,10 @@ llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_co
     return id;
 }
 
+llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first) {
+    return rguard_apply(gsmpl, common_sampler_sample_impl(gsmpl, ctx, idx, grammar_first));
+}
+
 std::vector<llama_token> common_sampler_sample_and_accept_n(struct common_sampler * gsmpl, struct llama_context * ctx, const std::vector<int> & idxs, const llama_tokens & draft, bool grammar_first) {
     GGML_ASSERT(idxs.size() == draft.size() + 1 && "idxs.size() must be draft.size() + 1");
 
@@ -999,8 +1105,12 @@ std::vector<llama_token> common_sampler_sample_and_accept_n_rejection(struct com
         }
 
         if (q_x > 0.0f && (p_x >= q_x || uni(gsmpl->rng) < p_x / q_x)) {
-            common_sampler_accept(gsmpl, draft[i], true);
-            result.push_back(draft[i]);
+            const llama_token id = rguard_apply(gsmpl, draft[i]);
+            common_sampler_accept(gsmpl, id, true);
+            result.push_back(id);
+            if (id != draft[i]) {
+                break; // the reasoning guard replaced a drafted end of generation: the drafted rest does not follow
+            }
             continue;
         }
 
@@ -1028,6 +1138,7 @@ std::vector<llama_token> common_sampler_sample_and_accept_n_rejection(struct com
             }
         }
 
+        id = rguard_apply(gsmpl, id);
         common_sampler_accept(gsmpl, id, true);
         result.push_back(id);
 
-- 
2.43.0

