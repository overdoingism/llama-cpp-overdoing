+void llama_memory_recurrent::anchor_commit(llama_seq_id seq_id) const {
+    // tiny graphs on the cache's own device: replay the start state of the cell's last batch into plane 0, copy the
+    // conv state's rollback plane into its plane 0.  Only when a state is read with a rollback pending.
+    auto * self = const_cast<llama_memory_recurrent *>(this);
+    for (uint32_t c = 0; c < size; ++c) {
+        mem_cell & cell = self->cells[c];
+        if (cell.seq_id.empty() || cell.pos < 0) {
+            continue;
+        }
+        if (seq_id >= 0 && !cell.has_seq_id(seq_id)) {
+            continue;
+        }
+        // the cell holds one state: a rollback pending for any of its sequences is the cell's
+        uint32_t     r   = 0;
+        llama_seq_id seq = -1;
+        for (const llama_seq_id sid : cell.seq_id) {
+            if (sid >= 0 && (size_t) sid < rs_idx.size() && rs_idx[sid] > r) {
+                r   = rs_idx[sid];
+                seq = sid;
+            }
+        }
+        if (r == 0) {
+            continue;
+        }
+        GGML_ASSERT(r <= cell.n_fac && cell.src == (int32_t) c);
+        const int32_t  nr = (int32_t) (cell.n_fac - r);
+        LLAMA_LOG_INFO("%s: seq %d: replaying %d of the last batch's %u tokens into the state before it is read\n",
+                __func__, seq, nr, cell.n_fac);
+
+        for (size_t il = 0; il < s_l.size(); ++il) {
+            ggml_tensor * s = s_l[il];
+            if (s == nullptr) {
+                continue;
+            }
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(s->buffer));
+            if (dev == nullptr) {
+                // a host buffer type without a device: the CPU backend reads it
+                dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+            }
+            ggml_backend_t & be = commit_backends[dev];
+            if (be == nullptr) {
+                be = ggml_backend_dev_init(dev, nullptr);
+                GGML_ASSERT(be != nullptr);
+            }
+
+            ggml_init_params ip = { 16 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+            ggml_context * ctx = ggml_init(ip);
+            const int64_t S = hparams.ssm_d_state, H = hparams.ssm_dt_rank;
+            ggml_tensor * a  = ggml_view_4d(ctx, s, S, S, H, 1, S * s->nb[0], S * S * s->nb[0], s->nb[1], (size + c) * s->nb[1]);
+            ggml_tensor * f  = f_l[il];
+            ggml_tensor * fa = ggml_view_3d(ctx, f, n_fac, fac_rows, 1, n_fac * f->nb[0], f->nb[1], (cell.fpar * size + c) * f->nb[1]);
+            ggml_tensor * n  = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+            ggml_tensor * st = ggml_gated_delta_net_replay(ctx, a, fa, n);
+            ggml_cgraph * gf = ggml_new_graph(ctx);
+            ggml_build_forward_expand(gf, ggml_cpy(ctx, st, ggml_view_2d(ctx, s, s->ne[0], 1, s->nb[1], c * s->nb[1])));
+            ggml_tensor * rl = r_l[il];
+            if (rl != nullptr) {
+                ggml_build_forward_expand(gf, ggml_cpy(ctx,
+                        ggml_view_2d(ctx, rl, rl->ne[0], 1, rl->nb[1], (r * size + c) * rl->nb[1]),
+                        ggml_view_2d(ctx, rl, rl->ne[0], 1, rl->nb[1], c * rl->nb[1])));
+            }
+            ggml_tensor * pl = p_l[il];
+            if (pl != nullptr) {
+                ggml_build_forward_expand(gf, ggml_cpy(ctx,
+                        ggml_view_2d(ctx, pl, pl->ne[0], 1, pl->nb[1], (r * size + c) * pl->nb[1]),
+                        ggml_view_2d(ctx, pl, pl->ne[0], 1, pl->nb[1], c * pl->nb[1])));
+            }
+            ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, be);
+            GGML_ASSERT(buf != nullptr && "anchored rollback: no memory for the commit graph");
+            ggml_backend_tensor_set(n, &nr, 0, sizeof(nr));
+            ggml_backend_graph_compute(be, gf);
+            ggml_backend_synchronize(be);
+            ggml_backend_buffer_free(buf);
