 static void ggml_compute_forward_gated_delta_net_one_chunk(
     const ggml_compute_params * params,
     ggml_tensor * dst,
@@ -11470,6 +11494,14 @@ static void ggml_compute_forward_gated_delta_net_one_chunk(
     // K (snapshot slot count) is an op param; state holds s0 only [S_v, S_v, H, n_seqs].
     const int64_t K = ggml_get_op_params_i32(dst, 0);
     GGML_ASSERT(K >= 1);
+
+    // anchored (ggml_gated_delta_net_anchor): replay n_replay[seq] factors of the previous batch first, then write the
+    // start state, the final state and this batch's factors
+    const bool          anchor   = ggml_get_op_params_i32(dst, 2) == 1;
+    const ggml_tensor * src_fac  = anchor ? dst->src[6] : nullptr;
+    const int32_t *     n_replay = src_fac != nullptr ? (const int32_t *) dst->src[7]->data : nullptr;
+    const int64_t       n_fac    = anchor ? ggml_gated_delta_net_n_fac(S_v, H, nek0, nek1) : 0;
+    GGML_ASSERT(!anchor || (K == 1 && !kda));
     // per-seq stride in floats (seq s starts at state + s * seq_stride)
     const int64_t state_seq_stride = src_state->nb[3] / sizeof(float);
 
@@ -11486,6 +11518,9 @@ static void ggml_compute_forward_gated_delta_net_one_chunk(
     const int64_t state_size_per_snap = S_v * S_v * H * n_seqs;
     float * attn_out_base  = (float *)dst->data;
     float * state_out_base = (float *)dst->data + attn_score_elems;
+    // anchored: [attn_scores | start states | final states | factors]
+    float * final_out_base = anchor ? state_out_base + state_size_per_snap : nullptr;
+    float * fac_out_base   = anchor ? final_out_base + state_size_per_snap : nullptr;
 
     // snapshot slot mapping: slot 0 = most recent state, slot s = s tokens back.
     // When n_tokens < K only slots 0..n_tokens-1 are written; older slots are caller-owned.
@@ -11513,13 +11548,26 @@ static void ggml_compute_forward_gated_delta_net_one_chunk(
         // For K>1, work in scratch and copy out per-token when the slot is in range.
         float * s_out = (K > 1)
             ? state_work
-            : state_out_base + (iv3 * H + iv1) * S_v * S_v;
+            : (anchor ? final_out_base : state_out_base) + (iv3 * H + iv1) * S_v * S_v;
 
         // copy input state into the working buffer and operate in-place
         // state layout [S_v, S_v, H, n_seqs]: seq iv3 starts at iv3 * state_seq_stride.
         const float * s_in = state_in_base + iv3 * state_seq_stride + iv1 * S_v * S_v;
         memcpy(s_out, s_in, S_v * S_v * sizeof(float));
 
+        if (anchor) {
+            if (n_replay != nullptr && n_replay[iv3] > 0) {
+                // the factors of sequence iv3: gathered ([n_fac, rows, n_seqs]) or row fac_ids[iv3] of src[6]
+                const ggml_tensor * src_ids = dst->src[8];
+                const float * fac = src_ids != nullptr
+                        ? (const float *) ((const char *) src_fac->data + ((const int32_t *) src_ids->data)[iv3] * src_fac->nb[1])
+                        : (const float *) src_fac->data + iv3 * src_fac->ne[1] * n_fac;
+                GGML_ASSERT(n_replay[iv3] <= (src_ids != nullptr ? src_fac->ne[0] / n_fac : src_fac->ne[1]));
+                ggml_gated_delta_net_replay_head(s_out, fac, n_fac, n_replay[iv3], S_v, H, nek1, iv1, delta);
+            }
+            memcpy(state_out_base + (iv3 * H + iv1) * S_v * S_v, s_out, S_v * S_v * sizeof(float));
+        }
+
         // attn output pointer for first token of this (head, seq)
         float * attn_data = attn_out_base + (iv3 * n_tokens * H + iv1) * S_v;
 
@@ -11544,7 +11592,17 @@ static void ggml_compute_forward_gated_delta_net_one_chunk(
                     ggml_vec_mul_f32(S_v, &s_out[j * S_v], &s_out[j * S_v], delta);
                 }
             } else {
-                ggml_vec_scale_f32(S_v * S_v, s_out, expf(g_d[0]));
+                const float g_val = expf(g_d[0]);
+                ggml_vec_scale_f32(S_v * S_v, s_out, g_val);
+                if (anchor) {
+                    float * row = fac_out_base + (iv3 * n_tokens + t) * n_fac;
+                    memcpy(row + iv1 * S_v, v_d, S_v * sizeof(float));
+                    if (iv1 < nek1) {
+                        memcpy(row + S_v * H + iv1 * S_v, k_d, S_v * sizeof(float));
+                    }
+                    row[S_v * H + S_v * nek1 + iv1]     = g_val;
+                    row[S_v * H + S_v * nek1 + H + iv1] = beta_val;
+                }
             }
 
             // delta[j] = sum_i S[i][j] * k[i] = dot(row j of M, k)
@@ -11639,6 +11697,35 @@ void ggml_compute_forward_gated_delta_net(
     }
 }
 
+// ggml_compute_forward_gated_delta_net_replay
+
+void ggml_compute_forward_gated_delta_net_replay(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * src_state = dst->src[0];
+    const ggml_tensor * src_fac   = dst->src[1];
+    const int32_t *     n_replay  = (const int32_t *) dst->src[2]->data;
+
+    const int64_t S_v    = src_state->ne[0];
+    const int64_t H      = src_state->ne[2];
+    const int64_t n_seqs = src_state->ne[3];
+    const int64_t n_fac  = src_fac->ne[0];
+    const int64_t H_k    = (n_fac - S_v * H - 2 * H) / S_v;
+
+    float * delta = (float *) params->wdata + params->ith * S_v + CACHE_LINE_SIZE_F32;
+
+    for (int64_t ir = params->ith; ir < H * n_seqs; ir += params->nth) {
+        const int64_t iv1 = ir % H;
+        const int64_t iv3 = ir / H;
+
+        float * s = (float *) dst->data + (iv3 * H + iv1) * S_v * S_v;
+        memcpy(s, (const float *) src_state->data + (iv3 * H + iv1) * S_v * S_v, S_v * S_v * sizeof(float));
+        GGML_ASSERT(n_replay[iv3] >= 0 && n_replay[iv3] <= src_fac->ne[1]);
+        ggml_gated_delta_net_replay_head(s, (const float *) src_fac->data + iv3 * src_fac->ne[1] * n_fac, n_fac,
+                n_replay[iv3], S_v, H, H_k, iv1, delta);
+    }
+}
+
 
 // ggml_compute_forward_dsv4_hc_comb
 
