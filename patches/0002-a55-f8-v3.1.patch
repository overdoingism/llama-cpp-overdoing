+#pragma once
+#include "common.cuh"
+// Llama-Frankenstein: FP8 flash attention for RDNA4 prefill (written by Claude).
+// GGML_LF_FA_FP8=1 turns it on (unset: off, nothing changes); GGML_LF_FA_FP8_MIN_T (default 32) is the smallest
+// token count it takes, so decode / speculative verify keep their kernels; GGML_LF_FA_FP8_MIN_KV (default 512) the
+// smallest KV length.
+// Head 64 / 128 / 256, GQA 1..8.  The q8_0 K/V cache stays as it is; each call converts it to fp8 e4m3 (K: one scale per token and head, V: transposed,
+// one scale per channel) the way the f16 path converts it to f16, Q gets one scale per token and head, and
+// S^T = K Q^T and O^T += V^T P^T run on v_wmma_f32_16x16x16_fp8_fp8 (P scaled by 2^8).  Results differ from the
+// f16 path (fp8 rounding of Q, K, V and P).
+bool ggml_cuda_lf_fa_fp8_supported(ggml_backend_cuda_context & ctx, const ggml_tensor * dst);
+void ggml_cuda_lf_fa_fp8(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
