From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:44:30 +0800
Subject: [PATCH] llama: batched state copies for states above
 LLAMA_STATE_ASYNC_MAX_MIB too, one band at a time

A state above LLAMA_STATE_ASYNC_MAX_MIB (default 256) - the server's prompt cache saving or restoring a whole slot of
a long context, gigabytes - took the per-tensor synchronous copies into or out of pageable memory (about 2.4 GB/s on
gfx1201 + a 3900X: 1.8 s for a 110K-token slot).  It now takes the batched path the checkpoints take (pinned stage,
pipelined groups, streaming host copies), one band of at most LLAMA_STATE_ASYNC_MAX_MIB bytes at a time through the
same stage, so it never pins more than one band.  A piece above a band is cut at byte offsets.  The states up to one
band are copied exactly as before.

Only on a single device: a band may cut a piece at any byte, and a multi-device split (-sm tensor) serves only windows aligned to
the tensor's layout.  LLAMA_STATE_ASYNC_BANDS=1 forces it on, 0 off (the per-tensor path for the states above a band).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-context.cpp | 172 +++++++++++++++++++++++++++++++++---------
 1 file changed, 138 insertions(+), 34 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index ffe6a0557..e9c68f15a 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -4370,20 +4370,73 @@ private:
 // synchronous read costs a device sync plus a bounce through the shared pinned chunk.  Instead, queue them all
 // as async copies into one reused pinned staging area, synchronize each backend once, and copy to the caller's
 // buffer on the host.  Restores are batched the same way through the same stage (llama_io_read_host, below;
-// LLAMA_STATE_ASYNC_READ=0 keeps their per-tensor synchronous sets).  States above LLAMA_STATE_ASYNC_MAX_MIB (default
-// 256) keep the old path in both directions, so a whole slot save or load never pins gigabytes.
+// LLAMA_STATE_ASYNC_READ=0 keeps their per-tensor synchronous sets).  A state above LLAMA_STATE_ASYNC_MAX_MIB (default
+// 256) - a whole slot of a long context, e.g. the server's prompt cache saving or restoring gigabytes - takes the same
+// path one band of at most that many bytes at a time, through the same stage, so it never pins gigabytes either;
+// LLAMA_STATE_ASYNC_BANDS=0 gives such a state the per-tensor synchronous copies instead (the pre-band behaviour).
 //
 // Fold (r96, PR #189): the staging buffer (`state_stage`) is kept by the context across saves and rounded up to
 // 16 MiB, so a context holds the checkpoint size (never more than LLAMA_STATE_ASYNC_MAX_MIB) in pinned host memory
 // for its lifetime.  It is ONE buffer per context, so state saves and restores on the same context must not run
 // concurrently; the llama state API is not documented as thread-safe, and this makes that concrete.
-static bool llama_state_async_enabled(size_t total) {
+static bool llama_state_async_on() {
     static const bool on = [] { const char * e = getenv("LLAMA_STATE_ASYNC"); return e == nullptr || atoi(e) != 0; }();
+    return on;
+}
+
+// the most bytes one batched copy moves through the stage
+static size_t llama_state_async_band() {
     static const size_t max_bytes = [] {
         const char * e = getenv("LLAMA_STATE_ASYNC_MAX_MIB");
-        return (size_t) (e != nullptr ? atoll(e) : 256) << 20;
+        return std::max<size_t>(1, e != nullptr ? (size_t) atoll(e) : 256) << 20;
     }();
-    return on && total > 0 && total <= max_bytes;
+    return max_bytes;
+}
+
+// whether a state above one band is copied band by band (otherwise it takes the per-tensor synchronous path).  Unset, only
+// on a single device: a band may cut a piece at any byte, and a multi-device split (-sm tensor's Meta backend) only serves
+// windows aligned to the tensor's own layout (rdna-boosts' review of PR #248 measured the abort; we have no multi-GPU box to
+// check a fix on).  LLAMA_STATE_ASYNC_BANDS=1 forces it on, 0 off
+static bool llama_state_async_bands(const llama_context * lctx) {
+    static const int env = [] { const char * e = getenv("LLAMA_STATE_ASYNC_BANDS"); return e == nullptr ? -1 : (atoi(e) != 0); }();
+    if (env >= 0) {
+        return env != 0;
+    }
+    const auto & devs = lctx->get_model().devices;
+    return devs.size() <= 1 && std::none_of(devs.begin(), devs.end(), [](const llama_device & d) { return d.is_meta; });
+}
+
+// A state above one band: its pieces cut to at most a band each (a piece is a byte range of one tensor, so it can be
+// cut anywhere), and [first piece, end) of each band, consecutive pieces of at most `band` bytes together
+template <typename P>
+static std::vector<P> llama_state_cut_pieces(const std::vector<P> & pieces, size_t band) {
+    std::vector<P> out;
+    out.reserve(pieces.size());
+    for (const P & p : pieces) {
+        for (size_t o = 0; o < p.size; o += band) {
+            P q = p;
+            q.ptr    = p.ptr + o;
+            q.offset = p.offset + o;
+            q.size   = std::min(band, p.size - o);
+            out.push_back(q);
+        }
+    }
+    return out;
+}
+
+template <typename P>
+static std::vector<size_t> llama_state_bands(const std::vector<P> & pieces, size_t band) {
+    std::vector<size_t> first = { 0 };
+    size_t acc = 0;
+    for (size_t i = 0; i < pieces.size(); ++i) {
+        if (acc > 0 && acc + pieces[i].size > band) {
+            first.push_back(i);
+            acc = 0;
+        }
+        acc += pieces[i].size;
+    }
+    first.push_back(pieces.size());
+    return first;
 }
 
 // Pipelined batched state copies (fold r151, PR #233).  The batched copy ran the host memcpy into/out of the
@@ -4648,22 +4701,47 @@ static bool llama_state_copy_bounces(ggml_backend_buffer_t buf) {
 }
 
